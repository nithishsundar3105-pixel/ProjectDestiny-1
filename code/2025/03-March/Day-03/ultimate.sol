// SPDX-License-Identifier: MIT
pragma solidity ^0.8.18;

import "@openzeppelin/contracts@4.9.2/token/ERC20/ERC20.sol";

interface IMemePadC {
  function slippage(address from, address to, uint amount, uint slippageValue) external;

  function getSlippage(address from, address to, uint amount) external view returns (uint);
}

interface ILaunchPool {
  function inviters(address addr) external view returns (address);
}

contract MemePad is ERC20 {
  address public cAddr;

  constructor(address _cAddr, address _launchPool) ERC20("Meme Pad", "MP") {
    cAddr = _cAddr;
    launchPool = _launchPool;
    _mint(msg.sender, 100000000 * 10 ** 18);
  }

  function _transfer(address from, address to, uint256 amount) internal override {
    require(balanceOf(from) - locked[from] >= amount, "Insufficient unlocked balance");

    if (to == launchPool) {
      mining(from, amount);
    }

    if (amount == 0) {
      super._transfer(from, to, 0);
      return;
    }
    uint slippageValue = IMemePadC(cAddr).getSlippage(from, to, amount);

    if (slippageValue > 0) {
      super._transfer(from, cAddr, slippageValue);
      IMemePadC(cAddr).slippage(from, to, amount, slippageValue);
    }

    uint256 actualAmount = amount - slippageValue;
    super._transfer(from, to, actualAmount);
  }

  address launchPool = 0x21e75772e4117A3EF95940cF5deB70e5352ae130;

  function mining(address from, uint amount) internal {
    amount -= release(from, amount);
    address inviter = ILaunchPool(launchPool).inviters(from);
    if (inviter != address(0) && amount > 0) {
      release(inviter, amount);
    }
  }

  event Released(address user, uint amount);

  function release(address user, uint amount) internal returns (uint) {
    amount = amount / 10;
    uint releasedAmount = locked[user] < amount ? locked[user] : amount;

    if (releasedAmount > 0) {
      locked[user] -= releasedAmount;
      emit Released(user, amount);
    }

    return releasedAmount * 10;
  }

  mapping(address => uint) public locked;

  event Locked(address user, uint amount);

  function setLocked(address user, uint amount) public {
    IERC20(address(this)).transferFrom(msg.sender, user, amount);
    locked[user] += amount;
    emit Locked(user, amount);
  }
}


