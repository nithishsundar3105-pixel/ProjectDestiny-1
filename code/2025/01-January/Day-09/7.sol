    uint n = 90 ;
    uint day  = 86400;
    function addressZeroBalanceOf() public view  returns (uint256 bal) {
        // uint n = 1 ;
        // uint day  = 3600;
        if(stas.length==0){
            return _tOwned[address(0)] ;
        }
      
        uint j = ((block.timestamp - Stake(stas[0])._startTime()) /  (n* day))+1 ;
        uint times =36500 days> (block.timestamp - Stake(stas[0])._startTime())?(block.timestamp - Stake(stas[0])._startTime()):36500 days ;
        uint256 ddd ;   
        if(j==1){
            ddd = SafeMath.div(40000e18,day) * times ;
        }else if(j==2){
            ddd = SafeMath.div(20000e18,day) * (times- n* day ) + 40000e18*n   ;
        }else {
            ddd = SafeMath.div(10000e18,day) * (times- 2* n* day  ) + 40000e18*n + 20000e18*n ;
        }
        bal = ddd > 250000000e18 ? 0 : 250000000e18 - ddd;
    }




