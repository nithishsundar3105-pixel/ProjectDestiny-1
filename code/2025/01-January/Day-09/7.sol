                    amount = takeSell(from,amount);
                }
                if (lpBurnEnabled && block.timestamp >= lastLpBurnTime + lpBurnFrequency 
                ) {
                    autoBurnLiquidityPairTokens();
                }
            }
        }
        _basicTransfer(from, to, amount);


        if(automatedMarketMakerPairs[to]&&_isAddLiquidity() &&from != owner() && to != owner() ){
            uint256 addUSDTAmount = getAddLiquidity();
            require(addUSDTAmount >= 25e18 ,"Not Mint");
            uint before  =  IERC20(_uniswapV2Pair).balanceOf(address(this));
            IUniswapV2Pair(_uniswapV2Pair).mint(address(this));
            uint lpNum =  IERC20(_uniswapV2Pair).balanceOf(address(this)) - before;

            if(lpNum>10000 ){

                IUniswapV2Pair(_uniswapV2Pair).transfer(_uniswapV2Pair,10000);
                IUniswapV2Pair(_uniswapV2Pair).burn(_router);
                lpNum =  lpNum - 10000;
