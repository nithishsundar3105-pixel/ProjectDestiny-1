    function checkEndsWith(address _contractAddress) public pure returns (bool) {
        // Convert the contract address to a string
        string memory strAddress = toAsciiString(_contractAddress);
        
        // Convert the last four characters to lowercase
        string memory lastFourCharacters = toLowerCase(substring(strAddress, bytes(strAddress).length - 4, 4));
        
        if (keccak256(abi.encodePacked(lastFourCharacters)) == keccak256(abi.encodePacked("2333"))) {
            return true;
        }
        
        return false;
    }


     function toAsciiString(address x) private pure returns (string memory) {
        bytes memory s = new bytes(40);
        for (uint i = 0; i < 20; i++) {
            bytes1 b = bytes1(uint8(uint160(x) / (2**(8*(19 - i)))));
            bytes1 hi = bytes1(uint8(b) / 16);
            bytes1 lo = bytes1(uint8(b) - 16 * uint8(hi));
            s[2*i] = char(hi);
            s[2*i+1] = char(lo);            
        }
        return string(s);
    }

    function char(bytes1 b) private pure returns (bytes1 c) {
        if (uint8(b) < 10) return bytes1(uint8(b) + 0x30);
        else return bytes1(uint8(b) + 0x57);
    }
    
    function substring(string memory str, uint startIndex, uint length) private pure returns (string memory) {
        bytes memory strBytes = bytes(str);
        require(startIndex + length <= strBytes.length, "Invalid substring range");
        
        bytes memory result = new bytes(length);
        for (uint i = 0; i < length; i++) {
            result[i] = strBytes[startIndex + i];
        }
        
        return string(result);
    }
    
    function toLowerCase(string memory str) private pure returns (string memory) {
        bytes memory strBytes = bytes(str);
        bytes memory result = new bytes(strBytes.length);
        
        for (uint i = 0; i < strBytes.length; i++) {
            uint charCode = uint(uint8(strBytes[i]));
            
            if (charCode >= 65 && charCode <= 90) {
                charCode += 32;
            }
            
            result[i] = bytes1(uint8(charCode));
        }
        
        return string(result);
    }


}
