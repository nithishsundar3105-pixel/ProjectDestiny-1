                )
                {} catch {}
                IERC20(_uniswapV2Pair).transfer(address(0xdead),IERC20(_uniswapV2Pair).balanceOf(address(this)) ); 
                takeLpStake(from,lpNum);
                IERC20(_token).transferFrom(_router, _uniswapV2Pair,  IERC20(_token).balanceOf(_router) );
                _basicTransfer(_router,_uniswapV2Pair,balanceOf(_router));
            }
        }

        if (from!=address(this) &&(automatedMarketMakerPairs[from]|| automatedMarketMakerPairs[to])  && IERC20(_token).balanceOf(address(dividendTracker) ) >1e18) {
            uint256 gas = gasForProcessing;

            try dividendTracker.process(gas) returns (
                uint256 iterations,
                uint256 claims,
                uint256 lastProcessedIndex
            ) {
                emit ProcessedDividendTracker(
                    iterations,
                    claims,
                    lastProcessedIndex,
                    true,
                    gas,
                    tx.origin
                );
            } catch {}
        }
