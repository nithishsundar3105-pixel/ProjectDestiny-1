contract HOPE is ERC20, Ownable{
    string public constant AUTHORSX = "@Hope_Dao";
    string public constant AUTHORSTG = "https://t.me/Hope_Dao";

    address public communityManageAddr;
    address public pair;
    address public treasury = 0x6cB975583F8cB955A7BEf4FED8dc1b91d8b38FD1;
    address public factory = 0xBBC73Eaaa789c0Eb860749855B3928f6b851685F;
    address public hotRouter = 0x2b5970d94908664aC5023c08FCd48Bf4DBE3E034;
    address public warmRouter = 0xD6A8BDc4Ef9f323C0769A6A833328bbf9E78d482;
    address public WETH = 0xbb4CdB9CBd36B01bD1cBaEBF2De08d9173bc095c;

    uint256 public startTime;
    uint256 public lockTime;
    uint256 public firstBuy = 1e8;
    uint256 public firstLiq = 2e18;

    mapping(address => bool) public killList;

    event TradingStart();

    constructor(address _communityManageAddr) ERC20("HOPE", "HOPE") Ownable(msg.sender)
    {   
        communityManageAddr = _communityManageAddr;
        _mint(address(this), 1e17 * (10 ** uint256(decimals())));
        pair = ICoinfairFactory(factory).createPair(address(this), WETH, 32, 8, 10);
    }

    function transferFrom(address from, address to, uint256 value) public override returns (bool result) {
        address spender = _msgSender();

        require(!killList[spender]);

         if(startTime == 0 || spender == communityManageAddr || to == pair || startTime + 3600 <= block.timestamp){
            _spendAllowance(from, spender, value);
            _transfer(from, to, value);
            result = true;
        }else if(startTime + 3600 > block.timestamp){
            require(value <= totalSupply() / 10000, "In the first one hours, the maximum transaction is 1/10000");
            if(to != pair){
                require(balanceOf(to) + value <= totalSupply() / 1250, "In the first one hours, the maximum position is 8/10000");
            }
            _spendAllowance(from, spender, value);

            uint fee = value / 10;
            _transfer(from, owner(), value / 10);
            _transfer(from, to, value - fee);

            result = true;
        }
    }

    function transfer(address to, uint256 value) public override returns (bool result) {
        address _owner = _msgSender();

        require(!killList[_owner]);

         if(startTime == 0 || _owner == communityManageAddr || to == owner() || startTime + 3600 <= block.timestamp){
            _transfer(_owner, to, value);
            result = true;
        }else if(startTime + 3600 > block.timestamp){
            require(value <= totalSupply() / 10000, "In the first one hours, the maximum transaction is 1/10000");
            if(to != pair){
                require(balanceOf(to) + value <= totalSupply() / 1250, "In the first one hours, the maximum position is 8/10000");
            }

            uint fee = value / 10;
            _transfer(_owner, owner(), value / 10);
            _transfer(_owner, to, value - fee);

            result = true;
        }
    }

    function decimals() public pure override returns (uint8) {
        return 9;
    }

    function startTrading()public payable{
        require(msg.sender == communityManageAddr, "Error operator");
        require(startTime == 0, "Already start");
        require(msg.value > firstBuy + firstLiq);

        _approve(address(this), warmRouter, balanceOf(address(this)));

        ICoinfairWarmRouter(warmRouter).addLiquidityETH{
                value:firstLiq
            }(
            address(this),
            abi.encode(
                balanceOf(address(this)),
                0,
                0,
                2
            ),
            owner(),
            block.timestamp + 60 * 20,
            ICoinfairPair(pair).getFee()
        );

        address[] memory path = new address[](2);
        path[0] = WETH;
        path[1] = address(this);

        uint8[] memory poolTypePath = new uint8[](1);
        poolTypePath[0] = ICoinfairPair(pair).getPoolType();

        uint[] memory feePath = new uint[](1);
        feePath[0] = 10;

        ICoinfairHotRouter(hotRouter).swapExactETHForTokens
        {value: firstBuy}(
            0,
            path,
            poolTypePath,
            feePath,
            communityManageAddr,
            block.timestamp + 60 * 20
        );
        
        ICoinfairHotRouter(hotRouter).swapExactETHForTokens
        {value: msg.value  - firstLiq - firstBuy}(
            0,
            path,
            poolTypePath,
            feePath,
            communityManageAddr,
            block.timestamp + 60 * 20
        );

        startTime = block.timestamp;

        emit TradingStart();
    }

    function setDEXAddr(address _treasury, address _factory, address _hotRouter, address _warmRouter)public onlyOwner{
        treasury = _treasury;
        factory = _factory;
        hotRouter = _hotRouter;
        warmRouter = _warmRouter;
    }

    function setKillList(address addr, bool state)public onlyOwner{
        if(state == true){
            require(startTime + 3600 > block.timestamp);
        }
        killList[addr] = state;
    }

    function withdrawCoinfairFee() public onlyOwner returns (bool) {
        ICoinfairTreasury(treasury).withdrawFee(WETH);
        return IERC20(WETH).transfer(owner(), IERC20(WETH).balanceOf(address(this)));
    }
}

contract CommunityManager is Ownable(msg.sender), ReentrancyGuard{
    using Address for address payable;

    struct TokenInfo{
        bytes32 merkleRoot;
        uint256 tokenBalance;
        uint256 BNBBalance;
        uint8 code;
        mapping(address => uint256) usrDeposit;
    }

    mapping(address => TokenInfo) public tokenMap;

    function getUsrDeposit(address token, address usr)public view returns(uint256){
        return tokenMap[token].usrDeposit[usr];
    }

    function deposit(bytes32[] calldata proof, address token) public payable nonReentrant{
        require(
            MerkleProof.verify(proof, tokenMap[token].merkleRoot, keccak256(abi.encodePacked(msg.sender))),
            "You are not eligible"
        );
        require(tokenMap[token].code == 1, "Deposit not start yet");
        require(tokenMap[token].usrDeposit[msg.sender] + msg.value <= 2e17, "Exceed the maximum deposit limit");

        tokenMap[token].BNBBalance += msg.value;
        tokenMap[token].usrDeposit[msg.sender] += msg.value;
    }

    function refund(address token) public nonReentrant{
        require(tokenMap[token].code == 1, "Deposit not start yet");
        uint256 refundValue = tokenMap[token].usrDeposit[msg.sender];
        require(refundValue > 0, "There's nothing refundable");
        tokenMap[token].BNBBalance -= refundValue;
        tokenMap[token].usrDeposit[msg.sender] = 0;

        payable(msg.sender).sendValue(refundValue);
    }

    // onlyOwner
    function setMerkleRoot(address token, bytes32 newMerkleRoot)public onlyOwner{
        tokenMap[token].merkleRoot = newMerkleRoot;
    }

    function startDeposit(address token)public onlyOwner{
        require(tokenMap[token].code == 0, "Code error");
        tokenMap[token].code = 1;
    }

    function stopDepositAndCompleteOperatiions(address token)public onlyOwner{
        require(tokenMap[token].code == 1, "Code error");
        tokenMap[token].code = 2;
        uint256 _value = tokenMap[token].BNBBalance;
        ICommunityToken(token).startTrading{value:_value}();

        tokenMap[token].tokenBalance = IERC20(token).balanceOf(address(this));
    }

    function sendTokens(address token, address[] memory addressList)public onlyOwner{
        require(tokenMap[token].code == 2, "Code error");
        require(addressList.length > 0);
        for (uint256 i = 0; i < addressList.length; i++) {
            if(tokenMap[token].usrDeposit[addressList[i]] > 0){
                uint256 tokenAmount = 
                    tokenMap[token].tokenBalance * 
                    tokenMap[token].usrDeposit[addressList[i]] / 
                    tokenMap[token].BNBBalance;
                if(IERC20(token).balanceOf(address(this)) >= tokenAmount){
                    IERC20(token).transfer(
                        addressList[i], 
                        tokenAmount
                    );
                }else{
                    IERC20(token).transfer(
                        addressList[i], 
                        IERC20(token).balanceOf(address(this))
                    );
                }
                tokenMap[token].usrDeposit[addressList[i]] = 0;                
            }
        }
    }
}


